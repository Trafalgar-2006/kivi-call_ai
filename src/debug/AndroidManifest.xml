<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a fake phone line for testing calls from a PC (see debug/FakeCarrier.kt). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".debug.FakeCarrier"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
        <!-- Only the shell (adb) holds DUMP, so no other app can ring the fake line. -->
        <receiver
            android:name=".debug.FakeCall"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
